	  Do NOT set LSUIElement. On macOS 26, LSUIElement + runtime accessory
	  switching causes Control Center to hide the menu bar item. We hide the
	  Dock at runtime with setActivationPolicy(.accessory) after the item exists.
	-->
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
